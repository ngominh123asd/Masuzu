# Provider chính
NVIDIA_NIM_API_KEY="your_api_key_here"
NVIDIA_NIM_BASE_URL="http://host.docker.internal:20128/v1"
MODEL="nvidia_nim/gemini/gemini-3.1-pro-preview"

# Model routing theo tier
MODEL_OPUS="nvidia_nim/gemini/gemini-3.1-pro-preview"
MODEL_SONNET="nvidia_nim/gemini/gemini-3-flash-preview"
MODEL_HAIKU="nvidia_nim/gemini/gemini-3.1-flash-lite-preview"

# Auth token (phải match với ANTHROPIC_AUTH_TOKEN trên client)
ANTHROPIC_AUTH_TOKEN="freecc"

# Thinking
ENABLE_MODEL_THINKING=true
